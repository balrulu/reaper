desc:BLT SPATIAL FIELD
author:Balrulu
version:0.5.0
changelog:BLT SERIES Beta TEST UPLOAD
provides:
  [script main=main] BLT_SPATIAL_FIELD_THEME_BRIDGE.lua > BLT ReaScripts/BLT_SPATIAL_FIELD_THEME_BRIDGE.lua
// v0.5.0 — horizontal binaural position and distance processor.
// SADIE II v2-1 D1 / KU100: Copyright 2018, University of York.
// Cal Armstrong, Lewis Thresh, Gavin Kearney. Apache-2.0 (see About).
// Source: https://doi.org/10.5281/zenodo.10886409
// Modified: 72 horizontal directions, front-relative log magnitude + ITD.
// Reduced HRTF model, not full-phase HRIR convolution. Measurements: 1.2m.
// Distance: 1..1000m, separate 1m reference; ISO 9613-1, 101.325kPa.
// 1024-point sqrt-Hann WOLA / hop 256; PDC 1026 samples.
// Optional travel delay is physical propagation, not PDC.
slider1:1<1,1000,0.01>距離 / Distance (m)
slider2:0<-180,180,0.01>方位 / Azimuth (deg)
slider3:1<0,1,1{OFF,ON}>音量 / Distance level
slider4:1<0,1,1{OFF,ON}>周波数 / Spectral correction
slider5:1<0,1,1{OFF,ON}>定位 / Spatial cues
slider6:20<-20,50,0.1>気温 / Temperature (C)
slider7:50<0,100,0.1>湿度 / Humidity (% RH)
slider8:1<0,2,1{OFF,Relative dispersion,Arrival + dispersion}>伝搬 / Propagation
slider9:0<-1000,1000,0.001>回転オフセット / Rotation (turns)
slider10:0<0,100,0.1>後方強調 / Rear emphasis (%)
options:gmem=BLT_SPATIAL_THEME
in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right

@init
slider_show(1023,0);
ext_nodenorm=1;
N=1024; H=256; mask=N-1;
inL=0; inR=1024; outL=2048; outR=3072; win=4096; synth_win=5120;
fftL=6144; fftR=8192;
alpha=11000; fi=12000; fm=13000; visL=14000; visR=15000;
delay_size=2^ceil(log(max(512,srate*3.3+1024))/log(2));delay_mask=delay_size-1;
delayL=100000;delayR=delayL+delay_size;
delay_filled=0;
memset(0,0,18000);
wp=0; hp=0; dp=0;
smooth=1-exp(-1/(0.020*srate));

sd=max(1,min(1000,slider1)); sa=max(-180,min(180,slider2));
base_az=sa;srot=max(-1000,min(1000,slider9));sback=max(0,min(100,slider10));
sa=base_az+360*srot;sa-=360*floor((sa+180)/360);
rear_curve=23000;
sv=slider3>=0.5; sf=slider4>=0.5; sp=slider5>=0.5;
st=slider6; sh=slider7; air_t=-999; air_h=-999;
se=slider8>=.5;arrival_mix=slider8>=1.5;
phase_per_m=19000;filter_lr=20000;filter_li=20600;filter_rr=21200;filter_ri=21800;
filter_dirty=1;
function air_update(temp,rh) local(t,tr,h,fo,fn,j,f,c0,c1,c2,nyq,ref_tau,tau) (
 t=273.15+temp; tr=t/293.15;
 h=rh*10^(-6.8346*(273.16/t)^1.261+4.6151);
 fo=24+40400*h*(.02+h)/(.391+h);
 fn=tr^(-.5)*(9+280*h*exp(-4.170*(tr^(-1/3)-1)));
 c0=0.0000000000184*sqrt(tr);
 c1=tr^(-2.5)*.01275*exp(-2239.1/t);
 c2=tr^(-2.5)*.1068*exp(-3352/t);
 nyq=srate*.5;
 ref_tau=(c1*fo*fo/(fo*fo+nyq*nyq)+c2*fn*fn/(fn*fn+nyq*nyq))*1.00001270588731/(2*$pi);
 fastest_slowness=1/(343.2*sqrt(tr))-(c1+c2)*1.00001270588731/(2*$pi)+ref_tau;
 max_relative_per_m=max(0,(c1+c2)*1.00001270588731/(2*$pi)-ref_tau);
 j=0;loop(N/2+1,
  f=j*srate/N;
  alpha[j]=8.686*f*f*(c0+c1/(fo+f*f/fo)+c2/(fn+f*f/fn));
  tau=(c1*fo*fo/(fo*fo+f*f)+c2*fn*fn/(fn*fn+f*f))*1.00001270588731/(2*$pi);
  phase_per_m[j]=-2*$pi*f*max(0,tau-ref_tau);j+=1;
 );
 air_t=temp;air_h=rh;filter_dirty=1;
);
air_update(st,sh);
i=0;
loop(N,
 win[i]=sqrt(0.5-0.5*cos(2*$pi*i/N)); synth_win[i]=win[i]/(2*N); i+=1;
);
i=0;
loop(N/2+1,
 f=i*srate/N;
 z=f<30 ? f/30 : 1+log(min(f,18000)/30)/log(600)*254;
 fi[i]=min(254,floor(z)); fm[i]=z-fi[i];
 rear_curve[i]=24*f*f/(f*f+2250000)*0.115129254649702;
 visL[i]=visR[i]=0;
 i+=1;
);
function clamp(v,lo,hi) ( max(lo,min(hi,v)); );
// Angular bases are shared by both ears and all frequency bins in a filter update.
function lookup(ear,k) local(a,b) (
 a=hrtf_a+ear*256+fi[k]; b=hrtf_b+ear*256+fi[k];
 (a[0]+(a[1]-a[0])*fm[k])*(1-af)+(b[0]+(b[1]-b[0])*fm[k])*af;
);
function delay_read(buf,d) local(pos,j,t,ym,y0,y1,y2,age) (
 pos=dp-d; j=floor(pos); t=pos-j;
 age=ceil(d);
 delay_filled>=age+1 ? (
  ym=buf[(j-1)&delay_mask];y0=buf[j&delay_mask];y1=buf[(j+1)&delay_mask];y2=buf[(j+2)&delay_mask];
 ) : (
  ym=0;
  y0=delay_filled>=age ? buf[j&delay_mask] : 0;
  y1=delay_filled>=age-1 ? buf[(j+1)&delay_mask] : 0;
  y2=delay_filled>=age-2 ? buf[(j+2)&delay_mask] : 0;
 );
 y0+0.5*t*(y1-ym+t*(2*ym-5*y0+4*y1-y2+t*(3*(y0-y1)+y2-ym)));
);
function unpack_hrtf(txt,addr) local(j,n,v) (
 j=0;n=strlen(txt);loop(n/3,
  v=35000[str_getchar(txt,j)]*4096+35000[str_getchar(txt,j+1)]*64+35000[str_getchar(txt,j+2)];
  addr[0]=(v-131072)/32768;addr+=1;j+=3;
 );
);
!hrtf_ready ? (
 #alphabet="ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
 i=0;loop(64,35000[str_getchar(#alphabet,i)]=i;i+=1;);
 unpack_hrtf("",40000);
 unpack_hrtf("",40341);
 unpack_hrtf("",40682);
 unpack_hrtf("",41023);
 unpack_hrtf("",41364);
 unpack_hrtf("",41705);
