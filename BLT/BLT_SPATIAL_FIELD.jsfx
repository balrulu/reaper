 unpack_hrtf("",67280);
 unpack_hrtf("",67621);
 unpack_hrtf("",67962);
 unpack_hrtf("",68303);
 unpack_hrtf("",68644);
 unpack_hrtf("",68985);
 unpack_hrtf("",69326);
 unpack_hrtf("",69667);
 unpack_hrtf("",70008);
 unpack_hrtf("",70349);
 unpack_hrtf("",70690);
 unpack_hrtf("",71031);
 unpack_hrtf("",71372);
 unpack_hrtf("",71713);
 unpack_hrtf("",72054);
 unpack_hrtf("",72395);
 unpack_hrtf("",72736);
 unpack_hrtf("",73077);
 unpack_hrtf("",73418);
 unpack_hrtf("",73759);
 unpack_hrtf("",74100);
 unpack_hrtf("",74441);
 unpack_hrtf("",74782);
 unpack_hrtf("",75123);
 unpack_hrtf("",75464);
 unpack_hrtf("",75805);
 unpack_hrtf("",76146);
 unpack_hrtf("",76487);
 unpack_hrtf("gmffademHeNVdvCdszdwueDheDkeAdeEweN9eK2eIreMXeVUeXTeLheJ1eLRd9peD3e5Ne+XeCRed1ep1elWeKOeJNeiEedAePxeWPefQeQE",76828);
 mem_set_values(80000,0,0.00005196188417,0.0001059461928,0.0001574765256,0.0002096356234,0.0002603437521,0.0003104260378,0.0003606257764,0.0004210254951,0.0004856583981,0.0005680117914,0.000649473707,0.0006997494241,0.0007303370635,0.0007498644182,0.0007636291554,0.0007717474181,0.0007774222281,0.0007792634634,0.000777008132,0.0007693289689,0.0007562309169,0.0007355360261,0.0006949354483);
 mem_set_values(80024,0.0006214151355,0.000536129871,0.0004702515046,0.0004163647933,0.0003680659583,0.000321028637,0.0002757997012,0.000228242971,0.0001796696712,0.0001309406234,0.00008224168468,0.00003076124852,-0.00001974108996,-0.00006965989576,-0.0001198785311,-0.0001688124974,-0.0002185674671,-0.0002654672594,-0.0003122239354,-0.0003608333937,-0.0004062536062,-0.000455941907,-0.000513227153,-0.000584735151);
 mem_set_values(80048,-0.0006671732352,-0.0007273677665,-0.0007596307218,-0.0007782667793,-0.0007898052456,-0.0007954032258,-0.0007965210497,-0.0007936259406,-0.0007866666649,-0.00077516796,-0.0007580321198,-0.0007331448216,-0.0006929252665,-0.0006281973632,-0.0005499425558,-0.0004780824304,-0.000418039533,-0.000365152814,-0.0003142316616,-0.0002632161652,-0.0002104907204,-0.0001590731065,-0.0001064239137,-0.00005399885179);
 mem_set_values(80100,0,-0.07199052222,-0.1441939131,-0.2093934788,-0.2721625855,-0.3324112223,-0.3946134327,-0.4596460403,-0.5389124695,-0.6147389827,-0.6886617117,-0.7439700564,-0.7436900197,-0.6095648939,-0.5040523844,-0.4382883493,-0.4018203539,-0.389753127,-0.3976247756,-0.4286064922,-0.4901789371,-0.5989384654,-0.7766705306,-0.7960494292);
 mem_set_values(80124,-0.7190235512,-0.6392662313,-0.5602483078,-0.4871996791,-0.4234956607,-0.3661690459,-0.3146359432,-0.2611599137,-0.2051228911,-0.1476357917,-0.08872126733,-0.02608379119,0.03651582708,0.09853243948,0.1606024509,0.2207661054,0.2801230048,0.3347646154,0.3881858694,0.4449293363,0.5021707032,0.568672164,0.6442808231,0.7240173497);
 mem_set_values(80148,0.8005083109,0.878599326,0.7537960772,0.5947547449,0.5090579533,0.4573204476,0.4337087009,0.4322405934,0.4530649873,0.4991739214,0.5777173353,0.6993633418,0.7774514728,0.7518416101,0.6905210757,0.6140678493,0.5369517373,0.4662723157,0.400674239,0.3384545732,0.2764207714,0.2141831832,0.1468451459,0.07574710439);
 hrtf_ready=1;
);

@slider
slider1=clamp(slider1,1,1000); slider2=clamp(slider2,-180,180);
slider6=clamp(slider6,-20,50);slider7=clamp(slider7,0,100);
slider8=clamp(floor(slider8+.5),0,2);
slider9=clamp(slider9,-1000,1000);slider10=clamp(slider10,0,100);
ext_tail_size=ceil(srate*3.5)+N;

@block
pdc_delay=N+2; pdc_bot_ch=0; pdc_top_ch=2;
apos=0;
av1=slider1; ap1=slider_next_chg(1,an1); ast1=ap1>0 ? (an1-av1)/ap1 : 0;
av2=slider2; ap2=slider_next_chg(2,an2); ast2=ap2>0 ? (an2-av2)/ap2 : 0;
av3=slider3; ap3=slider_next_chg(3,an3); ast3=ap3>0 ? (an3-av3)/ap3 : 0;
av4=slider4; ap4=slider_next_chg(4,an4); ast4=ap4>0 ? (an4-av4)/ap4 : 0;
av5=slider5; ap5=slider_next_chg(5,an5); ast5=ap5>0 ? (an5-av5)/ap5 : 0;

av6=slider6; ap6=slider_next_chg(6,an6); ast6=ap6>0 ? (an6-av6)/ap6 : 0;

av7=slider7; ap7=slider_next_chg(7,an7); ast7=ap7>0 ? (an7-av7)/ap7 : 0;

av8=slider8; ap8=slider_next_chg(8,an8); ast8=ap8>0 ? (an8-av8)/ap8 : 0;

av9=slider9;ap9=slider_next_chg(9,an9);ast9=ap9>0 ? (an9-av9)/ap9 : 0;

av10=slider10;ap10=slider_next_chg(10,an10);ast10=ap10>0 ? (an10-av10)/ap10 : 0;

@sample
ap1>0 && apos>=ap1 ? (av1=an1;ap1=slider_next_chg(1,an1);ast1=ap1>apos ? (an1-av1)/(ap1-apos) : 0;);
ap2>0 && apos>=ap2 ? (av2=an2;ap2=slider_next_chg(2,an2);ast2=ap2>apos ? (an2-av2)/(ap2-apos) : 0;);
ap3>0 && apos>=ap3 ? (av3=an3;ap3=slider_next_chg(3,an3);ast3=ap3>apos ? (an3-av3)/(ap3-apos) : 0;);
ap4>0 && apos>=ap4 ? (av4=an4;ap4=slider_next_chg(4,an4);ast4=ap4>apos ? (an4-av4)/(ap4-apos) : 0;);
ap5>0 && apos>=ap5 ? (av5=an5;ap5=slider_next_chg(5,an5);ast5=ap5>apos ? (an5-av5)/(ap5-apos) : 0;);
ap6>0 && apos>=ap6 ? (av6=an6;ap6=slider_next_chg(6,an6);ast6=ap6>apos ? (an6-av6)/(ap6-apos) : 0;);
ap7>0 && apos>=ap7 ? (av7=an7;ap7=slider_next_chg(7,an7);ast7=ap7>apos ? (an7-av7)/(ap7-apos) : 0;);
ap8>0 && apos>=ap8 ? (av8=an8;ap8=slider_next_chg(8,an8);ast8=ap8>apos ? (an8-av8)/(ap8-apos) : 0;);
ap9>0 && apos>=ap9 ? (av9=an9;ap9=slider_next_chg(9,an9);ast9=ap9>apos ? (an9-av9)/(ap9-apos) : 0;);
ap10>0 && apos>=ap10 ? (av10=an10;ap10=slider_next_chg(10,an10);ast10=ap10>apos ? (an10-av10)/(ap10-apos) : 0;);
sd+=smooth*(clamp(av1,1,1000)-sd);
ta=clamp(av2,-180,180);
da=ta-base_az;da>180 ? da-=360;da< -180 ? da+=360;
base_az+=smooth*da;base_az>180 ? base_az-=360;base_az< -180 ? base_az+=360;
srot+=smooth*(clamp(av9,-1000,1000)-srot);
sback+=smooth*(clamp(av10,0,100)-sback);
sa=base_az+360*srot;sa-=360*floor((sa+180)/360);
sv+=smooth*(clamp(av3,0,1)-sv);
sf+=smooth*(clamp(av4,0,1)-sf);
sp+=smooth*(clamp(av5,0,1)-sp);
st+=smooth*(clamp(av6,-20,50)-st);sh+=smooth*(clamp(av7,0,100)-sh);
se+=smooth*((av8>=.5)-se);arrival_mix+=smooth*((av8>=1.5)-arrival_mix);
gain=sv>.999999 ? 1/sd : sv<.000001 ? 1 : exp(-log(sd)*sv);
inL[wp]=spl0*gain; inR[wp]=spl1*gain;
yL=outL[wp]; yR=outR[wp]; outL[wp]=outR[wp]=0;
hp+=1;
hp>=H ? (
 hp=0; j=0;
 abs(st-air_t)>.0001 || abs(sh-air_h)>.0001 ? air_update(st,sh);
 loop(N,
  q=(wp+1+j)&mask;
  fftL[j*2]=inL[q]*win[j]; fftL[j*2+1]=0;
  fftR[j*2]=inR[q]*win[j]; fftR[j*2+1]=0; j+=1;
 );
 fft(fftL,N); fft_permute(fftL,N); fft(fftR,N); fft_permute(fftR,N);
 filter_dirty || abs(sd-cache_d)>.00001 || abs(sa-cache_a)>.00001 ||
 abs(sf-cache_f)>.000001 || abs(sp-cache_p)>.000001 || abs(se-cache_e)>.000001 || abs(sback-cache_back)>.00001 ? (
  an=(sa<0 ? sa+360 : sa)/5;ai=floor(an);af=an-ai;aj=(ai+1)%72;
  hrtf_a=40000+ai*512;hrtf_b=40000+aj*512;
  bd=80100[ai]*(1-af)+80100[aj]*af;
  rear_weight=max(0,-cos(sa*$pi/180))^2*sback*.01;
  k=0;loop(N/2+1,
   l=lookup(0,k);r=lookup(1,k);
   common=(l+r)*.5;diff=(l-r)*.5;
   air=alpha[k]*(sd-1)*0.115129254649702;
   rear_loss=rear_curve[k]*rear_weight;
   lg=sf*(common+sp*(diff-bd)-air-rear_loss)+sp*bd;
   rg=sf*(common-sp*(diff-bd)-air-rear_loss)-sp*bd;
   ml=exp(lg);mr=exp(rg);
   phase=phase_per_m[k]*(sd-1)*sf*se;
   pc=cos(phase);ps=sin(phase);
   filter_lr[k]=ml*pc;filter_li[k]=ml*ps;
   filter_rr[k]=mr*pc;filter_ri[k]=mr*ps;
   visL[k]=lg/0.115129254649702;visR[k]=rg/0.115129254649702;k+=1;
  );
  cache_d=sd;cache_a=sa;cache_f=sf;cache_p=sp;cache_e=se;cache_back=sback;
  filter_dirty=0;
 );
 k=0;loop(N/2+1,
  cr=filter_lr[k];ci=filter_li[k];xr=fftL[2*k];xi=fftL[2*k+1];
  fftL[2*k]=xr*cr-xi*ci;fftL[2*k+1]=xr*ci+xi*cr;
  cr=filter_rr[k];ci=filter_ri[k];xr=fftR[2*k];xi=fftR[2*k+1];
  fftR[2*k]=xr*cr-xi*ci;fftR[2*k+1]=xr*ci+xi*cr;
  k>0 && k<N/2 ? (
   fftL[2*(N-k)]=fftL[2*k];fftL[2*(N-k)+1]=-fftL[2*k+1];
   fftR[2*(N-k)]=fftR[2*k];fftR[2*(N-k)+1]=-fftR[2*k+1];
  );k+=1;
 );
 fft_ipermute(fftL,N); ifft(fftL,N); fft_ipermute(fftR,N); ifft(fftR,N);
 j=0;
 loop(N,
  q=(wp+1+j)&mask;
  outL[q]+=fftL[j*2]*synth_win[j];
  outR[q]+=fftR[j*2]*synth_win[j]; j+=1;
 );
);
wp=(wp+1)&mask;
an=(sa<0 ? sa+360 : sa)/5; ai=floor(an); af=an-ai; aj=(ai+1)%72;
itd=(80000[ai]*(1-af)+80000[aj]*af)*srate*sp;
delayL[dp]=yL; delayR[dp]=yR;
dl=2+max(0,itd);dr=2+max(0,-itd);
arrival_mix>=.000001 ? travel=clamp((sd-1)*fastest_slowness*srate,0,delay_size-1024);
arrival_mix<.000001 ? (
 spl0=delay_read(delayL,dl);spl1=delay_read(delayR,dr);
) : arrival_mix>.999999 ? (
 spl0=delay_read(delayL,dl+travel);spl1=delay_read(delayR,dr+travel);
) : (
 spl0=delay_read(delayL,dl)*(1-arrival_mix)+delay_read(delayL,dl+travel)*arrival_mix;
 spl1=delay_read(delayR,dr)*(1-arrival_mix)+delay_read(delayR,dr+travel)*arrival_mix;
);
dp=(dp+1)&delay_mask;
delay_filled<delay_mask ? delay_filled+=1;

apos+=1;
av1+=ast1;
av2+=ast2;
av3+=ast3;
av4+=ast4;
av5+=ast5;

av6+=ast6;

av7+=ast7;

av8+=ast8;

av9+=ast9;

av10+=ast10;

@serialize
file_var(0,fontmode);
file_var(0,chameleon);
file_var(0,ui_lang);

@gfx 700 614
!about_text_ready ? (
90000[0]="BLT SPATIAL FIELD v0.5.0 - Third-party notices";
90000[1]="";
90000[2]="SADIE II Database v2-1, D1 / Neumann KU100.";
90000[3]="Copyright 2018, University of York.";
90000[4]="Data developed at AudioLab, Department of Electronic Engineering,";
90000[5]="University of York, UK, by Cal Armstrong, Lewis Thresh and Gavin Kearney.";
90000[6]="Licensed under the Apache License, Version 2.0.";
90000[7]="https://www.apache.org/licenses/LICENSE-2.0";
90000[8]="Source: https://doi.org/10.5281/zenodo.10886409";
90000[9]="Paper: Armstrong, Thresh, Murphy and Kearney (2018),";
90000[10]="\"A Perceptual Evaluation of Individual and Non-Individual HRTFs:";
90000[11]="A Case Study of the SADIE II Database\", Applied Sciences 8(11), 2029.";
90000[12]="https://doi.org/10.3390/app8112029";
90000[13]="";
90000[14]="Modifications in BLT v0.5.0:";
90000[15]="48kHz SOFA horizontal data selected at approximately 5-degree intervals;";
90000[16]="azimuth converted to clockwise-positive; each ear normalized to front;";
90000[17]="regularized log magnitudes limited to -24/+12dB and sampled at 256 knots;";
90000[18]="low-pass interaural delay estimated and front-referenced.";
90000[19]="Original measured left/right differences retained; no mirror substitution.";
90000[20]="Distance and atmospheric propagation are separate BLT models.";
90000[21]="Distance range: 1..1000m; no near-field correction.";
90000[22]="SADIE log magnitudes packed as 18-bit fixed point; maximum quantization";
90000[23]="error below 0.000133dB. No external coefficient file is required.";
90000[24]="Molecular relaxation phase is derived from the same oxygen/nitrogen terms";
90000[25]="as ISO 9613-1 absorption. Nyquist phase velocity is the relative time";
90000[26]="reference.";
90000[27]="Optional additional travel time is referenced to 1m, not reported as PDC.";
90000[28]="Temperature / humidity defaults: 20 Celsius / 50 percent; pressure 101.325";
90000[29]="kPa.";
90000[30]="This is magnitude WOLA + fractional ITD, not full-phase HRIR convolution.";
90000[31]="No University of York or Neumann endorsement is implied.";
90000[32]="";
90000[33]="CHAMELEON: run BLT_SPATIAL_FIELD_THEME_BRIDGE.lua manually in REAPER.";
90000[34]="No automatic startup is installed. Audio does not need the bridge.";
90000[35]="";
90000[36]="The following Apache 2.0 license covers the derived SADIE data.";
90000[37]="It does not automatically license unrelated BLT code under Apache 2.0.";
90000[38]="";
90000[39]="Unwrapped rotation offsets and optional artistic rear attenuation.";
90000[40]="Rear emphasis is a BLT effect, not part of the measured SADIE dataset.";
90000[41]="";
