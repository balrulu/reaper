about_lines=245;about_pages=ceil(about_lines/20);about_text_ready=1;
);
function tr(jp,en) (ui_lang ? en : jp;);
function rawhit(x,y,w,h) ( mx>=x && mx<x+w && my>=y && my<y+h; );
function hit(x,y,w,h) ( !about_open && !lua_popup && rawhit(x,y,w,h); );
function rect(x,y,w,h) ( gfx_rect(ox+x*scale,oy+y*scale,w*scale,h*scale); );
function roundrect(x,y,w,h,r,aa) ( gfx_roundrect(ox+x*scale,oy+y*scale,w*scale,h*scale,r*scale,aa); );
function circle(x,y,r,fill,aa) ( gfx_circle(ox+x*scale,oy+y*scale,r*scale,fill,aa); );
function line(x,y,x2,y2) ( gfx_line(ox+x*scale,oy+y*scale,ox+x2*scale,oy+y2*scale,1); );
function ink(r,g,b,a) local(v,t,ar,ag,ab) (
 theme_active && b>r && b>=g ? (
  v=max(r,max(g,b));
  v<.38 ? (
   t=clamp((v-.055)/.8,0,.4);
   r=bg_r+(tx_r-bg_r)*t;g=bg_g+(tx_g-bg_g)*t;b=bg_b+(tx_b-bg_b)*t;
  ) : (
   t=clamp((b-r)/max(.001,b),0,1);
   ar=tx_r+(ac_r-tx_r)*t;ag=tx_g+(ac_g-tx_g)*t;ab=tx_b+(ac_b-tx_b)*t;
   r=ar;g=ag;b=ab;
  );
 ); gfx_set(r,g,b,a);
);
function label(x,y,txt,size,r,g,b) local(c,hasjp) (
 c=0;hasjp=0;loop(strlen(txt),str_getchar(txt,c,'cu')>127 ? hasjp=1;c+=1;);
 gfx_setfont(1,hasjp ? jpfont : latinfont,max(8,floor(size*scale+.5))); ink(r,g,b,1); gfx_x=ox+x*scale; gfx_y=oy+y*scale; gfx_drawstr(txt);
);
function right_label(x,y,txt,size,r,g,b) local(tw,th) (
 gfx_setfont(1,latinfont,max(8,floor(size*scale+.5)),0);
 gfx_measurestr(txt,tw,th);label(x-tw/scale,y,txt,size,r,g,b);
);
function panel(x,y,w,h) (
 ink(.048,.064,.091,1); rect(x,y,w,h);
 ink(.14,.21,.29,1); roundrect(x,y,w,h,8,1);
);
function notify_param(id,v,ending) (
 slider(id)=v; sliderchange(2^(id-1)); slider_automate(2^(id-1),ending);
);
function param_default(id) (id==1 || (id>=3 && id<=5) || id==8 ? 1 : id==6 ? 20 : id==7 ? 50 : 0;);
function param_min(id) (id==1 ? 1 : id==7 || id==10 ? 0 : id==6 ? -20 : id==9 ? -1000 : -180;);
function param_max(id) (id==1 ? 1000 : id==6 ? 50 : id==7 || id==10 ? 100 : id==9 ? 1000 : 180;);
function commit() local(v,ok,lo,hi) (
 editing ? (
  ok=match("%f",#edit,v);
  lo=param_min(editing);hi=param_max(editing);
  !ok ? (flash=1; flashid=editing;) : (
   (v<lo || v>hi) ? (flash=1; flashid=editing;);
   notify_param(editing,clamp(v,lo,hi),1);
  );
  editing=0;
 );
);
function field(id,x,y,w,title,unit) local(v,over,lo,hi,tw,th) (
 over=hit(x,y,w,42); v=slider(id); lo=param_min(id);hi=param_max(id);
 panel(x,y,w,42);
 over || active==id || editing==id ? (
  ink(.12,.62,.94,.8); roundrect(x,y,w,42,8,1);
 );
 flashid==id && flash>0 ? (ink(1,.2,.22,flash);roundrect(x-1,y-1,w+2,44,8,1););
 label(x+9,y+4,title,11,.62,.73,.83);
 editing==id ? strcpy(#val,#edit) : sprintf(#val,id==9 ? "%.3f" : "%.2f",v);
 editing!=id ? (
  while(strlen(#val)>0 && str_getchar(#val,strlen(#val)-1)==48) (strcpy_substr(#val,#val,0,strlen(#val)-1););
  str_getchar(#val,strlen(#val)-1)==46 ? strcpy_substr(#val,#val,0,strlen(#val)-1);
 );
 editing==id && selectall ? (
  gfx_set(.35,.76,1,1);rect(x+7,y+17,w-47,23);
  gfx_setfont(1,latinfont,max(8,floor(20*scale+.5)),0);
  gfx_set(.025,.045,.07,1);gfx_x=ox+(x+9)*scale;gfx_y=oy+(y+18)*scale;gfx_drawstr(#val);
 ) : (
  label(x+9,y+18,#val,20,.88,.95,1);
  editing==id && floor(now*2)%2==0 ? (
   gfx_measurestr(#val,tw,th);gfx_set(.35,.85,1,1);
   line(min(x+w-42,x+10+tw/scale),y+19,min(x+w-42,x+10+tw/scale),y+37);
  );
 );
 label(x+w-36,y+23,unit,11,.40,.64,.80);
 clicked && over ? (
  ctrl ? (
   editing && editing!=id ? commit();
   editing=0;active=0;notify_param(id,param_default(id),1);lastid=0;lastclick=0;
  ) : (
  editing && editing!=id ? commit();
  now-lastclick<.30 && lastid==id ? (
   active=0; editing=id; sprintf(#edit,id==9 ? "%.3f" : "%.2f",v); selectall=1;
  ) : (editing==id ? 0 : (commit(); active=id; startx=mx; starty=my; startv=v;));
  lastclick=now; lastid=id;
  );
 );
 active==id && down && !editing ? (
  vv=startv+floor(((mx-startx)-(my-starty))*.25)*(id==9 ? (shift ? .001 : .01) : (shift ? .1 : 1));
  (vv<lo || vv>hi) ? (flash=1; flashid=id;);
  vv=clamp(vv,lo,hi); vv!=v ? notify_param(id,vv,0);
 );
 over && mouse_wheel!=0 ? (
  commit(); vv=v+mouse_wheel/120*(id==9 ? (shift ? .001 : .01) : (shift ? .1 : 1));
  (vv<lo || vv>hi) ? (flash=1;flashid=id;);
  notify_param(id,clamp(vv,lo,hi),1); mouse_wheel=0;
 );
 editing==id ? edit_inside=over;
 over ? strcpy(#hint,tr("ドラッグ / ホイールで変更 ・ Shiftで微調整 ・ ダブルクリックで数値入力","Drag / wheel: adjust | Shift: fine | Double-click: type | Ctrl+click: reset"));
);
function toggle(id,x,y,w,txt) local(over,on) (
 over=hit(x,y,w,30);on=slider(id)>=.5;
 panel(x,y,w,30);over ? (ink(.15,.60,.92,.8);roundrect(x,y,w,30,5,1););
 label(x+7,y+3,txt,10,.76,.84,.93);
 ink(on ? .12 : .16,on ? .53 : .20,on ? .72 : .25,1);
 rect(x+7,y+18,26,10);
 ink(on ? .84 : .57,on ? .96 : .63,on ? 1 : .70,1);
 rect(x+(on ? 25 : 9),y+20,6,6);
 label(x+39,y+17,on ? "ON" : "OFF",9,on ? .55 : .47,on ? .87 : .55,on ? 1 : .64);
 clicked && over ? (commit();notify_param(id,!on,1););
);
jpfont=fontmode==1 ? "Hiragino Sans" : fontmode==2 ? "Noto Sans CJK JP" : "Yu Gothic UI";
latinfont=fontmode==1 ? "Helvetica Neue" : fontmode==2 ? "sans-serif" : "Segoe UI";
now=time_precise();
!bridge_observed ? (
 bridge_observed=1;bridge_tick=gmem[0];bridge_seen=-100;
 lua_prompt_pending=chameleon;lua_request_time=now;
) : gmem[0]!=bridge_tick ? (bridge_tick=gmem[0];bridge_seen=bridge_tick>0 ? now : -100;);
bridge_alive=bridge_tick>0 && now-bridge_seen<2;
bridge_alive ? (lua_popup=0;lua_prompt_pending=0;);
chameleon && lua_prompt_pending && now-lua_request_time>.65 && !bridge_alive && !about_open ? (
 lua_popup=1;lua_prompt_pending=0;active=0;editing=0;
);
theme_active=chameleon && bridge_alive;
bg_r=gmem[1];bg_g=gmem[2];bg_b=gmem[3];
tx_r=gmem[4];tx_g=gmem[5];tx_b=gmem[6];
ac_r=gmem[7];ac_g=gmem[8];ac_b=gmem[9]; down=mouse_cap&1; shift=mouse_cap&8;ctrl=mouse_cap&4;
clicked=down && !wasdown; released=!down && wasdown;
scale=max(.01,min(gfx_w/700,gfx_h/614)); ox=(gfx_w-700*scale)*.5; oy=(gfx_h-614*scale)*.5+26*scale;
mx=(mouse_x-ox)/scale; my=(mouse_y-oy)/scale;
gfx_dest=-1;
ink(.027,.036,.055,1);gfx_rect(0,0,gfx_w,gfx_h);
ink(.048,.064,.091,1);rect(0,-26,700,26);
label(14,-20,"S P A T I A L   F I E L D",10,.55,.83,.80);
label(393,-20,ui_lang ? "EN / JP" : "JP / EN",10,.51,.72,.83);
